# ===================================================================
# SERVER_WFS - FILE CẤU HÌNH MẪU DÀNH CHO TEAM (.env.example)
# ===================================================================
# HƯỚNG DẪN DÀNH CHO THÀNH VIÊN KHI CLONE DỰ ÁN VỀ:
# 1. Nhân bản file này và đổi tên thành: .env
# 2. Điền thông tin cấu hình của bạn/team vào các mục bên dưới.
# 3. Chạy lệnh: dotnet run --project src/Server_WFS.WebApi/Server_WFS.WebApi.csproj
# ===================================================================

# -------------------------------------------------------------------
# 1. CẤU HÌNH GOOGLE FIREBASE & FIRESTORE
# -------------------------------------------------------------------
# Project ID trên Firebase Console (Ví dụ: my-project-id)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Tên file chứng thực Service Account Private Key đặt trong src/Server_WFS.WebApi/
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Cấu hình Firebase Web Client (Lấy từ Firebase Console -> Project Settings -> General -> Web App)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
# Google OAuth 2.0 Web Client ID (Chống tấn công Token Substitution khi dùng Google One Tap/OAuth ID Token)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# -------------------------------------------------------------------
# 2. CẤU HÌNH BẢO MẬT JWT TOKEN
# -------------------------------------------------------------------
JWT_SECRET_KEY=YourSuperSecretKeyForWFSAuthenticationAtLeast32Chars!
JWT_ISSUER=Server_WFS
JWT_AUDIENCE=Server_WFS_Clients
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# -------------------------------------------------------------------
# 3. CẤU HÌNH GỬI EMAIL (GMAIL SMTP)
# -------------------------------------------------------------------
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER_EMAIL=your-email@gmail.com
EMAIL_SENDER_NAME=WFS Authentication Security
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_ENABLE_SSL=true

# Đặt true: Server sẽ in mã OTP ra Terminal (Dev Mock), không cần gửi mail thật.
# Đặt false: Server sẽ gửi email OTP thật vào hòm thư qua Google SMTP.
EMAIL_USE_MOCK=true
